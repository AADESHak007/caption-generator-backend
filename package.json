{
  "name": "caption-generator",
  "version": "1.0.0",
  "description": "AI-powered video caption generator with Next.js frontend",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "start:api": "node dist/server.js",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc",
    "build:web": "npm run build --workspace=web",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@types/cors": "^2.8.19",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.2.0",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
